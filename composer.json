{
  "name": "dylanlim/vault-php-sdk",
  "description": "Framework-independent PHP SDK for HashiCorp Vault and OpenBao-compatible APIs",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.2",
    "ext-curl": "*",
    "ext-json": "*",
    "psr/simple-cache": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5 || ^9.6 || ^10.5",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "OpenBao\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenBao\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 src tests"
  },
  "config": {
    "sort-packages": true
  }
}
