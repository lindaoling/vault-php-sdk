{
  "name": "latch/vault-php-sdk",
  "description": "Framework-independent PHP SDK for Vault-compatible APIs",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Vault\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vault\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 src tests"
  },
  "config": {
    "sort-packages": true
  }
}
